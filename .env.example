# Server
NODE_ENV=production
PORT=5000
JWT_SECRET=replace_with_a_64_byte_random_hex_secret

# Render PostgreSQL
# Prefer Render's internal DATABASE_URL for the backend service.
DATABASE_URL=postgresql://user:password@host:5432/lume
DB_SSL_NO_VERIFY=false
DB_POOL_MAX=10

# Frontend origins allowed by API and Socket.IO.
# Use your exact Vercel production URL. Add previews as comma-separated values if needed.
FRONTEND_URL=https://your-app.vercel.app
CLIENT_URL=https://your-app.vercel.app
ALLOWED_ORIGINS=https://your-app.vercel.app
# Optional, allows HTTPS origins whose host ends with this suffix.
VERCEL_PREVIEW_SUFFIX=.vercel.app
CALL_RING_TIMEOUT_MS=45000

# React build-time API URL for Vercel.
REACT_APP_API_URL=https://your-api.onrender.com
REACT_APP_CALL_RING_TIMEOUT_MS=45000

# Admin bootstrap. Set once, deploy, sign in, then rotate/remove if desired.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_password
SYSTEM_USER_PASSWORD=replace_with_a_strong_system_user_password

# Cloudflare R2 / S3-compatible file storage.
MINIO_ENDPOINT=your-account-id.r2.cloudflarestorage.com
MINIO_ACCESS_KEY=replace_with_access_key
MINIO_SECRET_KEY=replace_with_secret_key
MINIO_BUCKET_NAME=lume-uploads
MINIO_PUBLIC_URL=https://pub-your-public-r2-domain.r2.dev

# Email verification.
EMAILJS_SERVICE_ID=replace_with_service_id
EMAILJS_TEMPLATE_ID=replace_with_template_id
EMAILJS_PUBLIC_KEY=replace_with_public_key
EMAILJS_PRIVATE_KEY=replace_with_private_key

# TURN for 1-on-1 and mesh group calls. Required for reliable calls across NAT/firewalls.
METERED_APP_NAME=replace_with_metered_app_name
METERED_API_KEY=replace_with_metered_api_key

# LiveKit Cloud/SFU for stable group calls.
# Set these on the backend only. The API creates short-lived room tokens for the web app.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace_with_livekit_api_key
LIVEKIT_API_SECRET=replace_with_livekit_api_secret

# Frontend group-call engine:
# auto = use LiveKit when configured, fallback to mesh; mesh = force old Socket.IO mesh; livekit = require LiveKit.
REACT_APP_GROUP_CALL_MODE=auto

# Optional translation/STT features.
DEEPL_API_KEY=
DEEPGRAM_API_KEY=
